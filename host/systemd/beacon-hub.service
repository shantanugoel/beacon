# BEACON hub as a user service:
#   systemctl --user enable --now beacon-hub
# It talks to the herdr socket in this user's session, so it must run as the
# user, not as root.
[Unit]
Description=BEACON hub (agent mission control for the NOTE4)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/src/beacon/host
ExecStart=%h/src/beacon/.venv/bin/python -m beacon hub --port 8787
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
